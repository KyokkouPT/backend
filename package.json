{
  "name": "kyokkoupt-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env --import tsx src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env --import tsx dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrate": "node --env-file-if-exists=.env --import tsx src/db/migrate-cli.ts",
    "seed": "node --env-file-if-exists=.env --import tsx src/db/seed-cli.ts",
    "db:check": "node --env-file-if-exists=.env --import tsx src/db/check.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.6",
    "@fastify/rate-limit": "^11.2.1",
    "@kyokkou/config": "file:vendor/config",
    "@kyokkou/contracts": "file:vendor/contracts",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.7",
    "kysely": "^0.29.7",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.2.1",
    "pg": "^8.23.1",
    "tsx": "^4.23.15",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "typescript": "5.9.3",
    "vitest": "^5.0.5"
  }
}
