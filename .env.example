# KyokkouPT backend environment
#
# 复制为 .env 后按需修改；.env 已被 .gitignore 忽略，不会提交。
# 所有项都有默认值；生产环境必须替换 SESSION_SECRET / SEED_PASSWORD。

# ---- 运行 ----
# development | production | test
NODE_ENV=development
# 生产常用 0.0.0.0 或内网 IP
HOST=127.0.0.1
PORT=31001
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# ---- 数据库 ----
# sqlite | mysql | mariadb | postgres
DATABASE_DRIVER=sqlite
DATABASE_URL=file:./data/kyokkou.db
# MySQL:    mysql://kyokkou:password@127.0.0.1:3306/kyokkou
# MariaDB:  mysql://kyokkou:password@127.0.0.1:3306/kyokkou（DATABASE_DRIVER=mariadb）
# Postgres: postgres://kyokkou:password@127.0.0.1:5432/kyokkou

# ---- 站点公开地址 ----
# 写入 .torrent 的 announce、下载链接、RSS 链接；生产用 https://pt.example.com
KYOKKOU_BASE_URL=http://localhost:31002
# 可选：Tracker 独立公开地址；不设则使用 KYOKKOU_BASE_URL
# TRACKER_PUBLIC_URL=https://tracker.example.com

# ---- 安全 ----
# 至少 32 字节随机串；生产必须替换，否则拒绝启动
SESSION_SECRET=dev-only-insecure-session-secret-change-me-32
# 仅 pnpm seed 使用；生产必须替换，否则拒绝启动
SEED_PASSWORD=kyokkou-dev
# 生产默认 true（要求 HTTPS）；本地 HTTP 生产模拟设 false
# COOKIE_SECURE=false
# 生产默认 true（部署在 Nginx 后面）；直接访问 Node 时设 false
# TRUST_PROXY=false

# ---- 生产初始化（仅 pnpm admin:create 使用）----
# ADMIN_USERNAME=admin
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change-me-please
# BASE_SECTIONS=true
# 上面为 true 时导入 6 个基础分区模板（不含用户/种子/公告等演示数据）

# ---- 可选 SMTP ----
# 配置 SMTP_HOST 时必须同时配置 SMTP_FROM；SMTP_USER/SMTP_PASS 必须成对
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=notifications@example.com
# SMTP_PASS=replace-me
# SMTP_FROM=notifications@example.com
