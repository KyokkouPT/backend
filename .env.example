# 复制为 .env 后按需修改；不要在 .env 里提交真实 secret。
NODE_ENV=development
HOST=127.0.0.1
PORT=31001

# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# 数据库：sqlite | mysql | mariadb | postgres
DATABASE_DRIVER=sqlite
DATABASE_URL=file:./data/kyokkou.db
# DATABASE_URL=mysql://kyokkou:password@127.0.0.1:3306/kyokkou
# DATABASE_URL=postgres://kyokkou:password@127.0.0.1:5432/kyokkou

# 公开前端地址（announce/download/RSS 链接使用）；不要用 BASE_URL
KYOKKOU_BASE_URL=http://localhost:31002

# 32+ 字节；生产必须替换为随机值，否则拒绝启动
SESSION_SECRET=dev-only-insecure-session-secret-change-me-32

# seed 开发账号密码（lightbringer / root / 阿雪）；生产必须替换
SEED_PASSWORD=kyokkou-dev

# ---- 可选：标准 SMTP 邮件通知（不配置则只写站内信） ----
# 配置 SMTP_HOST 时必须同时配置 SMTP_FROM（发件人邮箱）。
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=notifications@example.com
# SMTP_PASS=replace-me
# SMTP_FROM=notifications@example.com
